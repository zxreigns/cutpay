# CutPay environment variables
# Copy this file to .env and fill in the values.

# Deployed CutPayEscrow contract address (set after running forge deploy).
# Leave as the zero address to run the UI without a live contract.
VITE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# Network: "testnet" connects to Arc Testnet (chain ID 5042002).
#          "mainnet" connects to Arc Mainnet  (chain ID 5042).
# Defaults to "testnet" when unset.
VITE_ARC_NETWORK=testnet
